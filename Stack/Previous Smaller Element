#include <bits/stdc++.h>
using namespace std;
vector<int>prevSmaller(vector<int>&v){
    stack<int>s;
    vector<int>ans;
    for(int i=0;i<v.size();i++){
        while(s.size()> 0&& s.top()>=v[i]){
            s.pop();
        }
        if(s.empty()){
            ans.push_back(-1);
        }
        else{
            ans.push_back(s.top());
        }
        s.push(v[i]);
    }
    return ans;
}
int main()
{
    vector<int>v={3,1,0,8,6};
    vector<int>result=prevSmaller(v);
    for(int i=0;i<result.size();i++){
        cout<<result[i]<<" ";
    }

    return 0;
}
