        vector<int>ans2(nums1.size(),0);
        unordered_map<int,int>mp;
        for(int j=nums2.size()-1;j>=0;j--){
            while(s.size()>0&&s.top()<=nums2[j]){
                 s.pop();
                 }
            if(s.empty()){
                mp[nums2[j]]=-1;
                }
            else{
                mp[nums2[j]]=s.top();
                    }
            s.push(nums2[j]);
                
