Stock span

#include <iostream>
#include <vector>
#include <stack>
using namespace std;
vector<int>stock(vector<int>&v){
    vector<int>ans;
    int span,current;
    stack<int>prevHigh;
    for(int i=0;i<v.size();i++){
        current =i;
        if(prevHigh.empty()){
            span=i+1;
            ans.push_back(span);
            prevHigh.push(current);
            continue;//to skip this iteration and start with the next
        }
        while(prevHigh.size()>0 && v[prevHigh.top()]<v[current]){
            prevHigh.pop();
        }
        if(v[prevHigh.top()]>=v[current]){
            span=current - prevHigh.top();
            ans.push_back(span);
            prevHigh.push(current);
        }
    }
    return ans;
}
int main()
{   
    vector<int>v={100,80,60,70,60,75,85};
    vector<int>result=stock(v);
    for(int i=0;i<result.size();i++){
        cout<<result[i]<<" ";
    }
    return 0;
}

