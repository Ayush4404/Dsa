Given n non-negative integers representing an elevation map where the width of each bar is 1, compute how much water it can trap after raining.

 

Example 1:


Input: height = [0,1,0,2,1,0,1,3,2,1,2,1]
Output: 6
Explanation: The above elevation map (black section) is represented by array [0,1,0,2,1,0,1,3,2,1,2,1]. In this case, 6 units of rain water (blue section) are being trapped.
Example 2:

Input: height = [4,2,0,3,2,5]
Output: 9
 

Constraints:

n == height.length
1 <= n <= 2 * 104
0 <= height[i] <= 105

not checking the boundary wrong approach
class Solution {
public:
    int trap(vector<int>& height) {
        int water=0,maxL=height[0];
        for(int i=1;i<height.size();i++){
            if(height[i]>maxL){
                maxL=height[i];
            }
            else{
                water+=maxL-height[i];
            }
        }
        return water;
    }
};

brute force approach
class Solution {
public:
    int trap(vector<int>& height) {
        int water=0;
        for(int i=0;i<height.size();i++){
            int l=0,r=0;
            for(int j=i;j>=0;j--){
                if(height[j]>l){
                    l=height[j];
                }
            }
            for(int k=i;k<height.size();k++){
                if(height[k]>r){
                    r=height[k];
                }
            }
            water+=min(l,r)-height[i];
        }
        return water;
    }
};
better approach

class Solution {
public:
    int trap(vector<int>& height) {
        int n=height.size();
        vector<int>lmax(n,0);
        vector<int>rmax(n,0);
        lmax[0]=height[0];
        rmax[n-1]=height[n-1];
        for(int i=1;i<n;i++){
            if(height[i]>lmax[i-1]){
                lmax[i]=height[i];
            }
            else{
                    lmax[i]=lmax[i-1];
            }
        }
        for(int i=n-2;i>=0;i--){
            if(height[i]>rmax[i+1]){
                rmax[i]=height[i];
            }
            else{
                    rmax[i]=rmax[i+1];
            }
        }
        int water=0;
        for(int i=0;i<n;i++){
            water+=min(lmax[i],rmax[i])-height[i];
        }
        return water;
    }
};

