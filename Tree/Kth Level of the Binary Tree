#include <bits/stdc++.h>
using namespace std;
class Node {
    public:
    int data;
    Node* left;
    Node* right;

    Node(int val) {
        data = val;
        left = nullptr;
        right = nullptr;
    }
};
static int idx=-1;
Node* buildPreorder(vector<int>Preoder){
    idx++;
    if(idx>=Preoder.size()||Preoder[idx]==-1){
        return NULL;
    }
    Node* root=new Node(Preoder[idx]);
    root->left=buildPreorder(Preoder);
    root->right=buildPreorder(Preoder);
    return root;
}
void KthLevel(Node*root,int k){
    if(root==NULL){
        return;
    }
    if(k==1){
        cout<<root->data<<" ";
        return;
    }
    KthLevel(root->left,k-1);
    KthLevel(root->right,k-1);
}

int main() {
	vector<int> preorder={1, 2,7,-1,-1,-1,3,4,-1,-1,5,-1,-1};
    Node* root=buildPreorder(preorder);
    int k=3;
    KthLevel(root,k);
}
