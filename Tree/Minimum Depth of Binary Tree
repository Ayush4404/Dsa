Use code with caution.If we pass this tree into your current code:At node 3, minDepth(root->left) goes to NULL and returns 0.
Your code calculates 1 + min(0, right_side_depth).Because min(0, right_side_depth) will always pick 0, your code will return 1 + 0 = 1.
But 3 is not a leaf node because it has a right child! The shortest path to a real leaf node (7) actually has a depth of 3 (nodes 3 → 20 → 7).
💡 The FixYou need to handle two extra edge cases before returning:If the left child is missing (NULL): You cannot take that path. 
You must force the algorithm to explore the right side.If the right child is missing (NULL): You must force the algorithm to explore the left side.
/**
 * Definition for a binary tree node.
 * struct TreeNode {
 *     int val;
 *     TreeNode *left;
 *     TreeNode *right;
 *     TreeNode() : val(0), left(nullptr), right(nullptr) {}
 *     TreeNode(int x) : val(x), left(nullptr), right(nullptr) {}
 *     TreeNode(int x, TreeNode *left, TreeNode *right) : val(x), left(left), right(right) {}
 * };
 */
class Solution {
public:
    int minDepth(TreeNode* root) {
        int left_side_depth=0,right_side_depth=0;
        if(root==NULL){
            return 0;
        }
        left_side_depth=minDepth(root->left);
        right_side_depth=minDepth(root->right);
        if(root->left==NULL){
            return 1+right_side_depth;
        }
        if(root->right==NULL){
            return 1+left_side_depth;
        }
        return 1+min(left_side_depth,right_side_depth);
    }
};
