#include <bits/stdc++.h>
using namespace std;
class Node {
    public:
    int data;
    Node* left;
    Node* right;

    Node(int val) {
        data = val;
        left = nullptr;
        right = nullptr;
    }
};
static int idx=-1;
Node* buildPreorder(vector<int>Preoder){
    idx++;
    if(idx>=Preoder.size()||Preoder[idx]==-1){
        return NULL;
    }
    Node* root=new Node(Preoder[idx]);
    root->left=buildPreorder(Preoder);
    root->right=buildPreorder(Preoder);
    return root;
}
int sumTree(Node* root){
    if(root==NULL){
        return 0;
    }
    int leftSum=sumTree(root->left);
    int rightSum=sumTree(root->right);
    root->data+=leftSum+rightSum;
    return root->data;
}

int main() {
	vector<int> preorder={1, 2,-1,-1,3,4,-1,-1,5,-1,-1};
    Node* root=buildPreorder(preorder);
    cout<<sumTree(root);

}
