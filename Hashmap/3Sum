Hint
Given an integer array nums, return all the triplets [nums[i], nums[j], nums[k]] such that i != j, i != k, and j != k, and nums[i] + nums[j] + nums[k] == 0.

Notice that the solution set must not contain duplicate triplets.

 

Example 1:

Input: nums = [-1,0,1,2,-1,-4]
Output: [[-1,-1,2],[-1,0,1]]
Explanation: 
nums[0] + nums[1] + nums[2] = (-1) + 0 + 1 = 0.
nums[1] + nums[2] + nums[4] = 0 + 1 + (-1) = 0.
nums[0] + nums[3] + nums[4] = (-1) + 2 + (-1) = 0.
The distinct triplets are [-1,0,1] and [-1,-1,2].
Notice that the order of the output and the order of the triplets does not matter.
Example 2:

Input: nums = [0,1,1]
Output: []
Explanation: The only possible triplet does not sum up to 0.
Example 3:

Input: nums = [0,0,0]
Output: [[0,0,0]]
Explanation: The only possible triplet sums up to 0.
 

Constraints:

3 <= nums.length <= 3000
-105 <= nums[i] <= 105
brute force is three nested loop and the check the statement of sum =0 and then we use the set to check the duplicacy if not present we insert after the sorting
class Solution {
public:
    vector<vector<int>> threeSum(vector<int>& nums) {
        int n=nums.size();
        vector<vector<int>>ans;
        set<vector<int>>s;
        for(int i=0;i<n;i++){
            int first=nums[i];
            for(int j=i+1;j<n;j++){
                int second=nums[j];
                for(int k=j+1;k<n;k++){
                    int third=nums[k];
                    if(first+second+third==0){
                        vector<int>trip={first,second,third};
                        sort(trip.begin(),trip.end());
                        if(s.find(trip)==s.end()){
                            s.insert(trip);
                            ans.push_back(trip);
                        }
                    }
                }
            }
        }
        return ans;
    }
};

complexity O(n^3)*O(log(triplets))
space is O(unique triplets*2)

better approach:
class Solution {
public:
    vector<vector<int>> threeSum(vector<int>& nums) {
        int n=nums.size();
      
        set<vector<int>>unique;
        for(int i=0;i<n;i++){
            int target=-nums[i];
            set<int>s;
            for(int j=i+1;j<n;j++){
                int toFind=target-nums[j];
                if(s.find(toFind)!=s.end()){
                    vector<int>trip={nums[i],nums[j],toFind};
                    sort(trip.begin(),trip.end());
                    unique.insert(trip);
                }
                s.insert(nums[j]);
            }
        }
        vector<vector<int>>ans(unique.begin(),unique.end());
        return ans;
    }
};
Let n be the number of elements.

Outer loop: O(n)
Inner loop: O(n)
Each set<int> operation: O(log n)
Inserting into set<vector<int>>: O(log m), where m is the number of unique triplets (at most O(n²)).

Overall time complexity is O(n² log n).

Space complexity is O(n) for the inner set plus the space needed to store the unique triplets.

optimal two pointers

class Solution {
public:
    vector<vector<int>> threeSum(vector<int>& nums) {
        int n=nums.size();
        vector<vector<int>>ans;
        sort(nums.begin(),nums.end());
        for(int i=0;i<n;i++){
            if(i>0&&nums[i]==nums[i-1]){
                continue;
            }
            int j=i+1,k=n-1;
            while(j<k){
                int sum=nums[i]+nums[j]+nums[k];
                if(sum==0){
                    ans.push_back({nums[i],nums[j],nums[k]});
                        j++;k--;
                        while(j<k&&nums[j]==nums[j-1]){
                        j++;
                        }
                }
                else if(sum>0){
                    k--;
                }
                else{
                    j++;
                }
            }
        }
        return ans;
    }
};
