            temp->next=NULL;
            delete temp;
        }
        void pop_back(){
            if(head==NULL){
                cout<<"LL is empty"<<endl;
                return;
            }
            Node* temp=head;
            while(temp->next!=tail){
                temp=temp->next;
            }
            temp->next=NULL;
            delete tail;
            tail=temp;
        }
        void insert_middle(int val,int pos){
            if(pos<0){
                return;
            }
            if(pos==0){
                push_front(val);
            }
            Node* newNode= new Node(val);
