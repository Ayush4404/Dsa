#include<iostream>
using namespace std;
class CircularQueue{
    int* arr;//dyanmic
    int currSize,cap,f,r;
    public:
    CircularQueue(int size){
        cap=size;
        arr=new int[cap];
        f=0,r=-1,currSize=0;
    }
    void push(int data){
        if(currSize==cap){
            cout<<"full"<<endl;
            return;
        }
        r=(r+1)%cap;
        arr[r]=data;
        currSize++;
    }
    void pop(){
        if(currSize==0){
            cout<<"empty"<<endl;
            return;
        }
        f=(f+1)%cap;
        currSize--;
    }
    int front(){
        if(currSize==0){
            cout<<"empty"<<endl;
            return -1;
        }
        return arr[f];
    }
    bool empty(){
        if(currSize==0){
            return true;
        }
        return false;
    }
};
int main(){
    CircularQueue cq(3);
    cq.push(1);
    cq.push(2);
    cq.push(3);
    cq.pop();
    cq.push(4);
    while(!cq.empty()){
        cout<<cq.front()<<" ";
        cq.pop();
    }
}
