// Online C++ compiler to run C++ program online
#include <iostream>
#include<vector>
using namespace std;
void help(vector<vector<int>>&maze,int row,int col,string path,vector<string>&ans){
    //valid row and col
    int n=maze.size();
    if(row<0||col<0||row>=n||col>=n||maze[row][col]==0||maze[row][col]==-1){
        return;
    }
    //ans
    if(row==n-1&&col==n-1){
        ans.push_back({path});
        return;
    }
    maze[row][col]=-1;
    help(maze,row+1,col,path+"D",ans);//down
    help(maze,row-1,col,path+"U",ans);//up
    help(maze,row,col-1,path+"L",ans);//left
    help(maze,row,col+1,path+"R",ans);//right
    //backtrack
    maze[row][col]=1;
    
    
}
vector<string>findPath(vector<vector<int>>&maze){
    vector<string>ans;
    int n=maze.size();
    string path="";
    help(maze,0,0,path,ans);
    return ans;
}
int main() {
    vector<vector<int>>maze={{1,0,0,0},{1,1,0,1},{1,1,0,0},{0,1,1,1}};
    vector<string>ans=findPath(maze);
    for(string path:ans){
        cout<<path<<endl;
    }
    return 0;
}

